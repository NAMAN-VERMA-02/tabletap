# Leave both empty in development (Vite proxies /api and /socket.io to localhost:5000).

# Production (Vercel): /api is proxied to the API by vercel.json, so VITE_API_URL stays empty.
VITE_API_URL=
# Production: the API's own URL, for the live kitchen/order websocket, e.g. https://tabletap-api.onrender.com
VITE_SOCKET_URL=
