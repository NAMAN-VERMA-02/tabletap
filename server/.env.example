PORT=5000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/tabletap  |  Atlas: mongodb+srv://<user>:<pass>@<cluster>/tabletap
MONGO_URI=mongodb://127.0.0.1:27017/tabletap
# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
